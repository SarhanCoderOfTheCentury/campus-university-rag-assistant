# Leave unset until the real, authenticated FastAPI RAG service exists.
# Never put LLM/provider secrets into a VITE_* variable.
# Vercel production/preview: use the full HTTPS endpoint of the future AWS API.
# VITE_RAG_STREAM_URL=https://your-real-api-domain/api/chat/stream
# VITE_RAG_STREAM_URL=http://localhost:8000/api/chat/stream

# Default: no browser cookies sent to the AWS API. Bearer auth uses the transport's headers callback.
VITE_RAG_CREDENTIALS=omit
# Use include only when the real backend uses cross-origin cookie authentication.

# Optional local development proxy ONLY (not a production Vercel API):
# VITE_RAG_STREAM_URL=/api/chat/stream
# RAG_DEV_API_ORIGIN=http://localhost:8000
