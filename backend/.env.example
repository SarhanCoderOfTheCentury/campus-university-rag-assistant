# Importable server functions; these are NOT implemented with fake production data.
# RAG_FACTORY=my_university.rag:build_service
# RAG_AUTH_FACTORY=my_university.auth:authorize_request
RAG_ALLOWED_ORIGINS=http://localhost:5173,https://campus-university-assistant-ui.roanwand4.chatgpt.site
# Put provider keys only in your server environment. No keys are bundled here.

# Production entrypoint: backend.aws_app:app (uses the public-document agent, not these factories).
# AWS deployment script configures these values. Model key lives in Secrets Manager.
RAG_PROVIDER_SECRET=campus-rag/gemini
RAG_LIMIT_TABLE=campus-rag-limits
RAG_DAILY_LIMIT=100
GEMINI_MODEL=gemini-3.5-flash-lite
